@model IEnumerable<PlasticLicensingApp.ViewModels.SupplierDashboardViewModel>
@{
    ViewData["Title"] = "My Supplier Companies";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-success"><i class="fas fa-building me-2"></i>My Supplier Companies</h2>
        <a asp-action="Register" class="btn btn-success rounded-pill shadow-sm">
            <i class="fas fa-plus me-1"></i> Register New Company
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="card shadow-sm border-0 text-center p-5">
            <div class="card-body">
                <div class="display-1 text-muted mb-4"><i class="fas fa-briefcase"></i></div>
                <h4>No Companies Registered Yet</h4>
                <p class="text-muted mb-4">You haven't registered any supplier companies under your account. To start submitting products for licensing, please register your company first.</p>
                <a asp-action="Register" class="btn btn-lg btn-success rounded-pill px-5">Get Started</a>
            </div>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 hover-card transition">
                        <div class="card-body">
                            <div class="d-flex justify-content-between mb-3">
                                <h5 class="card-title fw-bold text-dark">@item.CompanyName</h5>
                                <span class="badge bg-light text-success border border-success">Active</span>
                            </div>
                            <p class="card-text text-muted mb-1"><i class="fas fa-map-marker-alt me-2"></i>@item.City, @item.State</p>
                            <p class="card-text text-muted mb-4"><i class="fas fa-calendar-alt me-2"></i>Since @item.CreatedDate.ToString("MMM yyyy")</p>
                            
                            <div class="d-flex gap-2 mt-auto">
                                <a asp-action="Edit" asp-route-id="@item.ID" class="btn btn-outline-success flex-fill rounded-pill btn-sm">Edit Profile</a>
                                <a href="#" class="btn btn-success flex-fill rounded-pill btn-sm">View Products</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .hover-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
    }
    .transition {
        transition: all 0.3s ease;
    }
</style>