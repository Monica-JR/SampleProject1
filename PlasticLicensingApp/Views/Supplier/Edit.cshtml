@model PlasticLicensingApp.ViewModels.SupplierEditViewModel
@{
    ViewData["Title"] = "Edit Supplier Profile";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow border-0 rounded-3">
                <div class="card-header bg-success text-white py-3">
                    <h4 class="mb-0"><i class="fas fa-edit me-2"></i>Edit Supplier Profile</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="ID" />
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <h5 class="text-success mb-3 border-bottom pb-2">Company Details</h5>
                        <div class="mb-4">
                            <label asp-for="SupplierCompanyName" class="form-label fw-bold"></label>
                            <input asp-for="SupplierCompanyName" class="form-control form-control-lg" placeholder="Enter company name" />
                            <span asp-validation-for="SupplierCompanyName" class="text-danger"></span>
                        </div>

                        <h5 class="text-success mb-3 border-bottom pb-2">Address Information</h5>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Line1" class="form-label fw-bold"></label>
                                <input asp-for="Line1" class="form-control" />
                                <span asp-validation-for="Line1" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Line2" class="form-label fw-bold"></label>
                                <input asp-for="Line2" class="form-control" />
                                <span asp-validation-for="Line2" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="City" class="form-label fw-bold"></label>
                                <input asp-for="City" class="form-control" />
                                <span asp-validation-for="City" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="State" class="form-label fw-bold"></label>
                                <input asp-for="State" class="form-control" />
                                <span asp-validation-for="State" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="Pincode" class="form-label fw-bold"></label>
                                <input asp-for="Pincode" class="form-control" />
                                <span asp-validation-for="Pincode" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Country" class="form-label fw-bold"></label>
                                <input asp-for="Country" class="form-control" />
                                <span asp-validation-for="Country" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-4">
                                <label asp-for="Phone" class="form-label fw-bold"></label>
                                <input asp-for="Phone" class="form-control" />
                                <span asp-validation-for="Phone" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="d-flex gap-2 pt-3">
                            <button type="submit" class="btn btn-success rounded-pill px-4 shadow-sm flex-fill">
                                <i class="fas fa-save me-1"></i> Save Changes
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 flex-fill">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}