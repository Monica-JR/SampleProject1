@model PlasticLicensingApp.ViewModels.EditSupplierProfileViewModel
@{
    ViewData["Title"] = "Edit Supplier Company Profile";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-success text-white py-3 d-flex justify-content-between align-items-center">
                    <h2 class="mb-0 fs-4"><i class="fas fa-building me-2"></i>Edit Company Profile</h2>
                    <a asp-action="Index" class="btn btn-sm btn-outline-light rounded-pill">
                        <i class="fas fa-arrow-left me-1"></i> Back to List
                    </a>
                </div>
                <div class="card-body p-4">
                    <form asp-action="EditProfile" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ID" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                        <div class="mb-4">
                            <label asp-for="SupplierCompanyName" class="form-label fw-bold"></label>
                            <input asp-for="SupplierCompanyName" class="form-control form-control-lg" placeholder="e.g. EcoPlastics Ltd" />
                            <span asp-validation-for="SupplierCompanyName" class="text-danger"></span>
                        </div>

                        <hr />
                        <h4 class="mb-3 text-muted">Company Address</h4>

                        <div class="mb-3">
                            <label asp-for="Line1" class="form-label fw-bold"></label>
                            <input asp-for="Line1" class="form-control" placeholder="Street Address, P.O. Box" />
                            <span asp-validation-for="Line1" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Line2" class="form-label fw-bold"></label>
                            <input asp-for="Line2" class="form-control" placeholder="Apartment, suite, unit, building, floor, etc." />
                            <span asp-validation-for="Line2" class="text-danger"></span>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="City" class="form-label fw-bold"></label>
                                <input asp-for="City" class="form-control" placeholder="City" />
                                <span asp-validation-for="City" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="State" class="form-label fw-bold"></label>
                                <input asp-for="State" class="form-control" placeholder="State / Province" />
                                <span asp-validation-for="State" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="Pincode" class="form-label fw-bold"></label>
                                <input asp-for="Pincode" class="form-control" placeholder="Postal Code / Pincode" />
                                <span asp-validation-for="Pincode" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Country" class="form-label fw-bold"></label>
                                <input asp-for="Country" class="form-control" placeholder="Country" />
                                <span asp-validation-for="Country" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Phone" class="form-label fw-bold"></label>
                            <input asp-for="Phone" class="form-control" placeholder="e.g. +91 98765 43210" />
                            <span asp-validation-for="Phone" class="text-danger"></span>
                        </div>

                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-success btn-lg flex-fill rounded-pill shadow-sm">
                                <i class="fas fa-save me-1"></i> Save Changes
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg flex-fill rounded-pill">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
