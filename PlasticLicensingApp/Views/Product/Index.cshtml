@model PlasticLicensingApp.ViewModels.SupplierProductsViewModel
@{
    ViewData["Title"] = "Products - " + Model.SupplierName;
}

<div class="container mt-4">
    <!-- Breadcrumb & Header -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Supplier" asp-action="Index" class="text-decoration-none">My Supplier Companies</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.SupplierName - Products</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-success mb-1">
                <i class="fas fa-boxes me-2"></i>Products - @Model.SupplierName
            </h2>
            <p class="text-muted mb-0">Manage and submit products associated with this supplier company.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Supplier" asp-action="Index" class="btn btn-outline-secondary rounded-pill">
                <i class="fas fa-arrow-left me-1"></i> Back to Companies
            </a>
            <button type="button" class="btn btn-success rounded-pill shadow-sm" data-bs-toggle="modal" data-bs-target="#createProductModal">
                <i class="fas fa-plus me-1"></i> Create Product
            </button>
        </div>
    </div>

    <!-- Alert Messages Area -->
    <div id="pageAlertSuccess" class="alert alert-success alert-dismissible fade show shadow-sm" role="alert" style="display: none;">
        <i class="fas fa-check-circle me-2"></i><span id="pageAlertSuccessMessage"></span>
        <button type="button" class="btn-close" onclick="$('#pageAlertSuccess').hide()" aria-label="Close"></button>
    </div>

    <div id="pageAlertError" class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert" style="display: none;">
        <i class="fas fa-exclamation-triangle me-2"></i><span id="pageAlertErrorMessage"></span>
        <button type="button" class="btn-close" onclick="$('#pageAlertError').hide()" aria-label="Close"></button>
    </div>

    <!-- Products Container (Knockout Controlled) -->
    <div id="productsListContainer">
        <!-- Loading Spinner -->
        <div class="text-center py-5" data-bind="visible: isLoading">
            <div class="spinner-border text-success" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2 text-muted">Refreshing products...</p>
        </div>

        <!-- Empty State -->
        <div class="card shadow-sm border-0 text-center p-5" data-bind="visible: !isLoading() && products().length === 0">
            <div class="card-body">
                <div class="display-1 text-muted mb-4"><i class="fas fa-box-open"></i></div>
                <h4>No Products Found</h4>
                <p class="text-muted mb-4">No products have been registered for @Model.SupplierName yet. Click the button below to add your first product.</p>
                <button type="button" class="btn btn-lg btn-success rounded-pill px-5" data-bs-toggle="modal" data-bs-target="#createProductModal">
                    <i class="fas fa-plus me-1"></i> Create Product
                </button>
            </div>
        </div>

        <!-- Products Table -->
        <div class="card shadow-sm border-0 mb-4" data-bind="visible: !isLoading() && products().length > 0">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <span class="fw-bold text-dark">
                    Registered Products (<span data-bind="text: products().length"></span>)
                </span>
                <button class="btn btn-sm btn-outline-success rounded-pill" data-bind="click: refreshProducts, disable: isLoading">
                    <i class="fas fa-sync-alt me-1" data-bind="css: { 'fa-spin': isLoading }"></i> Refresh
                </button>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col" style="width: 80px;">#</th>
                            <th scope="col">Product Name</th>
                            <th scope="col">Parameters / Specifications</th>
                            <th scope="col">Status</th>
                            <th scope="col">Created Date</th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: products">
                        <tr>
                            <td class="text-muted" data-bind="text: id"></td>
                            <td>
                                <strong class="text-dark" data-bind="text: productName"></strong>
                            </td>
                            <td>
                                <div data-bind="if: parameters && parameters.length > 0">
                                    <div class="d-flex flex-wrap gap-1" data-bind="foreach: parameters">
                                        <span class="badge bg-light text-dark border">
                                            <span class="text-secondary" data-bind="text: parameterName + ': '"></span>
                                            <strong data-bind="text: parameterValue"></strong>
                                        </span>
                                    </div>
                                </div>
                                <div data-bind="if: !parameters || parameters.length === 0">
                                    <span class="text-muted fst-italic">None</span>
                                </div>
                            </td>
                            <td>
                                <span class="badge" data-bind="text: statusName, css: {
                                    'bg-success': statusName === 'Approved',
                                    'bg-warning text-dark': statusName === 'Pending' || statusName === 'Submitted',
                                    'bg-danger': statusName === 'Rejected',
                                    'bg-secondary': statusName !== 'Approved' && statusName !== 'Pending' && statusName !== 'Submitted' && statusName !== 'Rejected'
                                }"></span>
                            </td>
                            <td class="text-muted" data-bind="text: formattedDate"></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Create Product Modal -->
<div class="modal fade" id="createProductModal" tabindex="-1" aria-labelledby="createProductModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="createProductModalLabel">
                    <i class="fas fa-box-open me-2"></i>Create Product for @Model.SupplierName
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4" id="createProductFormContainer">
                <div class="mb-4">
                    <label class="form-label fw-bold">Product Name <span class="text-danger">*</span></label>
                    <input type="text" class="form-control form-control-lg" data-bind="value: productName" placeholder="e.g. Recycled PET Container" />
                </div>

                <hr />
                <h6 class="mb-3 text-secondary fw-bold"><i class="fas fa-sliders-h me-1"></i> Technical Parameters</h6>

                <div class="row g-3" data-bind="foreach: parameters">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold" data-bind="text: parameterName"></label>
                        <input type="text" class="form-control" data-bind="value: value" placeholder="Enter value..." />
                    </div>
                </div>

                <div class="alert alert-danger mt-3" data-bind="visible: formError, text: formError" style="display: none;"></div>
                <div class="alert alert-success mt-3" data-bind="visible: formSuccess, text: formSuccess" style="display: none;"></div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-outline-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success rounded-pill px-4" data-bind="click: submitProduct, disable: isSubmitting">
                    <span class="spinner-border spinner-border-sm me-2" data-bind="visible: isSubmitting" style="display: none;"></span>
                    <span data-bind="text: isSubmitting() ? 'Submitting...' : 'Save & Submit Product'"></span>
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var initialProducts = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.Products));
        var initialParameters = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.CreateProductModel.Parameters));
        var currentSupplierId = @Model.SupplierId;

        function ProductItemModel(data) {
            var self = this;
            self.id = data.id || data.Id;
            self.productName = data.productName || data.ProductName || '';
            self.statusName = data.statusName || data.StatusName || 'Pending';
            self.parameters = data.parameters || data.Parameters || [];
            
            var rawDate = data.createdDate || data.CreatedDate;
            if (rawDate) {
                var d = new Date(rawDate);
                self.formattedDate = isNaN(d.getTime()) ? rawDate : d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
            } else {
                self.formattedDate = '-';
            }
        }

        function ProductsPageViewModel() {
            var self = this;

            // Products list state
            self.isLoading = ko.observable(false);
            self.products = ko.observableArray(initialProducts.map(function(item) {
                return new ProductItemModel(item);
            }));

            // Form state
            self.productName = ko.observable('');
            self.parameters = ko.observableArray(initialParameters.map(function(p) {
                return {
                    parameterId: p.ParameterID || p.parameterId,
                    parameterName: p.ParameterName || p.parameterName,
                    value: ko.observable(p.Value || p.value || '')
                };
            }));
            self.isSubmitting = ko.observable(false);
            self.formError = ko.observable('');
            self.formSuccess = ko.observable('');

            // Function to reload products list via API
            self.refreshProducts = function() {
                self.isLoading(true);
                return fetch('/Product/GetBySupplier?supplierId=' + currentSupplierId)
                    .then(function(res) {
                        if (!res.ok) throw new Error('Failed to load products');
                        return res.json();
                    })
                    .then(function(data) {
                        var mapped = (data || []).map(function(p) {
                            return new ProductItemModel(p);
                        });
                        self.products(mapped);
                    })
                    .catch(function(err) {
                        console.error('Error refreshing products:', err);
                        $('#pageAlertErrorMessage').text('Failed to refresh products list.');
                        $('#pageAlertError').show();
                    })
                    .finally(function() {
                        self.isLoading(false);
                    });
            };

            // Reset modal form
            self.resetForm = function() {
                self.productName('');
                self.parameters().forEach(function(p) {
                    p.value('');
                });
                self.formError('');
                self.formSuccess('');
                self.isSubmitting(false);
            };

            // Submit product
            self.submitProduct = function() {
                if (!self.productName() || self.productName().trim() === '') {
                    self.formError('Product Name is required.');
                    return;
                }

                self.isSubmitting(true);
                self.formError('');
                self.formSuccess('');

                var payload = {
                    supplierId: currentSupplierId,
                    productName: self.productName().trim(),
                    parameters: self.parameters().map(function(p) {
                        return {
                            parameterId: p.parameterId,
                            parameterName: p.parameterName,
                            value: p.value() || ''
                        };
                    })
                };

                fetch('/Product/Create', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(payload)
                })
                .then(function(res) {
                    if (!res.ok) {
                        return res.text().then(function(text) {
                            throw new Error(text || 'Submission failed');
                        });
                    }
                    return res.json();
                })
                .then(function(result) {
                    if (result.success) {
                        self.formSuccess('Product created successfully!');

                        // Refresh list immediately
                        self.refreshProducts();

                        // Hide modal after short delay
                        setTimeout(function() {
                            var modalEl = document.getElementById('createProductModal');
                            var modalInstance = bootstrap.Modal.getInstance(modalEl);
                            if (modalInstance) {
                                modalInstance.hide();
                            }
                            self.resetForm();

                            $('#pageAlertSuccessMessage').text('Product successfully created and added to the list!');
                            $('#pageAlertSuccess').show();
                            setTimeout(function() {
                                $('#pageAlertSuccess').fadeOut();
                            }, 5000);
                        }, 800);
                    } else {
                        self.formError(result.message || 'An error occurred during submission.');
                    }
                })
                .catch(function(err) {
                    self.formError('Server error or submission failed: ' + (err.message || 'Please try again.'));
                })
                .finally(function() {
                    self.isSubmitting(false);
                });
            };
        }

        var pageViewModel = new ProductsPageViewModel();
        ko.applyBindings(pageViewModel, document.getElementById('productsListContainer'));
        ko.applyBindings(pageViewModel, document.getElementById('createProductModal'));

        // Reset form when modal is closed
        var modalEl = document.getElementById('createProductModal');
        if (modalEl) {
            modalEl.addEventListener('hidden.bs.modal', function() {
                pageViewModel.resetForm();
            });
        }
    </script>
}
